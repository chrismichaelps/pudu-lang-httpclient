/** @Test.Support.Placeholder.Data.Module — the seed records of the placeholder service */
module Support.Placeholder.Data

import Std.Json as Json

/** @Test.Support.Placeholder.Data.Relation — a nested route: the child resource and its parent key */
export type Relation = { parent: Str, child: Str, key: Str }

/// The resources the service holds, in the order they are listed.
export const RESOURCES: Array[Str] = ["posts", "comments", "albums", "photos", "todos", "users"]

/// How many records each resource starts with, as the public service holds.
export const COUNTS: Map[Str, Int] = mapOf([("posts", 100), ("comments", 500), ("albums", 100), ("photos", 5000), ("todos", 200), ("users", 10)])

/// The nested routes: `/parent/:id/child` lists the children whose key is the parent's id.
export const RELATIONS: Array[Relation] = [
  Relation{parent: "posts", child: "comments", key: "postId"},
  Relation{parent: "albums", child: "photos", key: "albumId"},
  Relation{parent: "users", child: "posts", key: "userId"},
  Relation{parent: "users", child: "albums", key: "userId"},
  Relation{parent: "users", child: "todos", key: "userId"}
]

