/// Every resource's records as the service starts with them.
export fn seed() -> Map[Str, Array[Json.Json]] {
  mapOf([
      ("posts", numbered(100, |id: Int| Json.object(&[("userId", Json.Number(owner(id, 10))), ("id", Json.Number(id)), ("title", Json.Text("post " + show(id))), ("body", Json.Text("the body of post " + show(id)))]))),
      ("comments", numbered(500, |id: Int| Json.object(&[("postId", Json.Number(owner(id, 5))), ("id", Json.Number(id)), ("name", Json.Text("comment " + show(id))), ("email", Json.Text("reader" + show(id) + "@example.test")), ("body", Json.Text("the body of comment " + show(id)))]))),
      ("albums", numbered(100, |id: Int| Json.object(&[("userId", Json.Number(owner(id, 10))), ("id", Json.Number(id)), ("title", Json.Text("album " + show(id)))]))),
      ("photos", numbered(5000, |id: Int| Json.object(&[("albumId", Json.Number(owner(id, 50))), ("id", Json.Number(id)), ("title", Json.Text("photo " + show(id))), ("url", Json.Text("https://picsum.photos/seed/" + show(id) + "/600")), ("thumbnailUrl", Json.Text("https://picsum.photos/seed/" + show(id) + "/150"))]))),
      ("todos", numbered(200, |id: Int| Json.object(&[("userId", Json.Number(owner(id, 20))), ("id", Json.Number(id)), ("title", Json.Text("todo " + show(id))), ("completed", Json.Boolean(id % 3 == 0))]))),
      ("users", numbered(10, |id: Int| user(id, &USERS[id - 1])))
    ])
}

/// The records numbered from 1 to `count`.
fn numbered(count: Int, make: fn(Int) -> Json.Json) -> Array[Json.Json] {
  var records: Array[Json.Json] = []
  var id = 1
  while id <= count {
    records = records.push(make(id))
    id = id + 1
  }
  records
}

/// The owner of a record when every owner holds `per` records in order.
fn owner(id: Int, per: Int) -> Int { (id - 1) / per + 1 }

/// One user record from its fields.
fn user(id: Int, fields: &Array[Str]) -> Json.Json {
  let text = |index: Int| Json.Text(fields[index])
  Json.object(&[
      ("id", Json.Number(id)), ("name", text(0)), ("username", text(1)), ("email", text(2)),
      ("address", Json.object(&[("street", text(3)), ("suite", text(4)), ("city", text(5)), ("zipcode", text(6)), ("geo", Json.object(&[("lat", text(7)), ("lng", text(8))]))])),
      ("phone", text(9)), ("website", text(10)),
      ("company", Json.object(&[("name", text(11)), ("catchPhrase", text(12)), ("bs", text(13))]))
    ])
}
